# Copie para .env.local (desenvolvimento) ou .env (Docker) e troque os valores.

# Senha do painel em /admin. Sem ela, o painel fica desativado.
ADMIN_PASSWORD=troque-esta-senha

# Opcional: segredo para assinar a sessão. Sem ele, é derivado da senha.
# SESSION_SECRET=

# Opcional: em produção o login exige HTTPS. Use false só para testar via http num IP da rede.
# COOKIE_SECURE=false

# Opcional: endereço público do site (o campo "Endereço do site" do painel tem prioridade).
# SITE_URL=https://www.seusite.com.br
